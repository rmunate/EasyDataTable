  "keywords": [
    "laravel",
    "datatable",
    "easy-datatable",
    "data-grid",
    "backend",
    "laravel-package"
  ],
  "homepage": "https://github.com/rmunate/EasyDataTable",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Rmunate\\EasyDatatable\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Raul Mauricio Uñate Castro",
      "email": "raulmauriciounate@gmail.com",
      "homepage": "https://github.com/rmunate",
      "role": "owner"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0",
    "illuminate/database": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/http": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0"
  },
  "scripts": {
    "test": "phpunit --bootstrap vendor/autoload.php tests"
  }
